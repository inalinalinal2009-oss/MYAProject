PORT=8787

# SMTP settings (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_mailbox@gmail.com
SMTP_PASS=replace_with_google_app_password
SMTP_FROM=SmartAptechka <your_mailbox@gmail.com>

# CORS security
# Add your frontend URL(s) if needed
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Optional API throttling
MAX_START_PER_15_MIN=60
MAX_VERIFY_PER_15_MIN=120
